        "shouldAnswer": true,
        "expectedSources": [
          "proceso_bloqueo_tarjeta.txt"
        ],
        "mustContain": [
          [
            "bloque",
            "perdida",
            "extravi",
            "robo"
          ]
        ],
        "note": "'hacerlo' se refiere al bloqueo; sin historial la búsqueda no sabe a qué trámite se refiere"
      },
      {
        "message": "¿y después puedo pedir otra tarjeta?",
        "type": "dependiente",
        "shouldAnswer": true,
        "expectedSources": [
          "proceso_bloqueo_tarjeta.txt",
          "proceso_cambio_tarjeta.txt"
        ],
        "mustContain": [
          [
            "bloque",
            "perdida",
            "perdi",
            "extravi",
            "robo"
          ],
          [
            "reemplazo",
            "reposicion",
            "otra tarjeta",
            "nueva tarjeta",
            "tarjeta nueva",
            "emision"
          ]
        ],
        "note": "'después' y 'otra tarjeta' dependen de la pérdida y el bloqueo anteriores"
      }
    ]
  },
